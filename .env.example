VITE_APP_NAME=ServiceDesk Repair Shop
VITE_SUPPORT_EMAIL=support@example.com
VITE_SUPPORT_PHONE=+1-555-0100
VITE_API_BASE_URL=

# Use a long random value in Railway. Example command:
# openssl rand -base64 48
# Required in production — the server refuses to start without a non-default value when NODE_ENV=production.
AUTH_SECRET=change-this-long-random-secret-before-deploy
SESSION_TTL_HOURS=168

# Railway Postgres injects this automatically when you attach a Postgres service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/service_desk
PGSSLMODE=disable
# Set to false only if your Postgres provider uses a self-signed certificate internally.
PGSSL_REJECT_UNAUTHORIZED=true
PORT=3000
# Set to "production" when deploying — enables the AUTH_SECRET startup check.
NODE_ENV=development

# Comma-separated list of allowed frontend origins, e.g. https://app.example.com
# Leave unset for local dev; the server warns and accepts any origin until this is set.
CORS_ORIGIN=

# Set to "true" only for local/demo deployments — seeds a demo org, demo accounts
# (admin/agent/technician/customer @servicedesk.local), and sample business data on
# first boot. Leave unset (or any other value) in production so a fresh deploy starts empty.
SEED_DEMO_DATA=false
